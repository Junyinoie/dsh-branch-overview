{
  "name": "dsh-branch-overview",
  "version": "0.2.9",
  "type": "module",
  "description": "Branch manager for the DSH Web GUI: a composer chip showing the session repository and branch, with switching, stash/discard, pull/push and unsaved/unpushed markers.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "branch",
    "branch-overview",
    "cordis",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "git",
    "git-branch",
    "worktree"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Junyinoie/dsh-branch-overview.git"
  },
  "homepage": "https://github.com/Junyinoie/dsh-branch-overview#readme",
  "bugs": {
    "url": "https://github.com/Junyinoie/dsh-branch-overview/issues"
  },
  "author": "Junyinoie"
}
